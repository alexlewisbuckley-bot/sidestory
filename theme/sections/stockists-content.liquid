
<div class="inner">
  <p class="crumb"><a href="{{ section.settings.s1 }}">{{ section.settings.s15 }}</a> / Stockists</p>
  <div class="phead"><p class="k">{{ section.settings.s3 }}</p><h1>{{ section.settings.s4 }}</h1>
