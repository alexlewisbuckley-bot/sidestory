    <div class="tile"><h3>{{ section.settings.s8 }}</h3><p>Dubai<br>United Arab Emirates</p></div>
    <div class="tile"><h3>{{ section.settings.s9 }}</h3><p>Doha<br>Qatar</p></div>
  </div>
  <div class="grid-3">
    <div class="tile"><h3>{{ section.settings.s10 }}</h3><p>Doha<br>Qatar</p></div>
    <div class="tile"><h3>{{ section.settings.s11 }}</h3><p>Kuwait City<br>Kuwait</p></div>
    <div class="tile"><h3>{{ section.settings.s12 }}</h3><p>Riyadh<br>Saudi Arabia</p></div>
  </div>
  <div class="pfoot">
    <p class="k">{{ section.settings.s13 }}</p>
    <p>{{ section.settings.s14 }}</p>
    <p><a class="ul" href="{{ section.settings.s2 }}">{{ section.settings.s16 }}</a></p>
  </div>
</div>

