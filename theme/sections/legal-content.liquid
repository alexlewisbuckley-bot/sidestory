
<div class="inner">
  <p class="crumb"><a href="{{ section.settings.s1 }}">{{ section.settings.s12 }}</a> / Legal</p>
  <div class="phead"><p class="k">{{ section.settings.s3 }}</p><h1>{{ section.settings.s4 }}</h1></div>
  <div class="artgrid">
    <div class="col">
      <h2 class="sechead">{{ section.settings.s5 }}</h2>
      <p>{{ section.settings.s6 }}</p>
      <p>You can ask us for a copy of everything we hold, or ask us to delete it, by writing to <a href="{{ section.settings.s2 }}">{{ section.settings.s13 }}</a>. We answer within 2 working days.</p>
      <h2 class="sechead">{{ section.settings.s7 }}</h2>
      <p>{{ section.settings.s8 }}</p>
      <p>{{ section.settings.s9 }}</p>
      <h2 class="sechead">{{ section.settings.s10 }}</h2>
      <p>{{ section.settings.s11 }}</p>
    </div>
  </div>
</div>

{% schema %}
{
 "name": "Legal content",
 "settings": [
  {
   "type": "text",
   "id": "s1",
   "label": "Link URL",
   "default": "/"
  },
  {
   "type": "text",
   "id": "s2",
   "label": "Link URL 2",
   "default": "mailto:info@sidestoryparfums.com"
  },
  {
   "type": "text",
   "id": "s3",
   "label": "Text",
   "default": "Legal"
  },
  {
   "type": "text",
   "id": "s4",
   "label": "Heading",
   "default": "Privacy, terms &amp;&nbsp;cookies."
  },
  {
   "type": "text",
   "id": "s5",
   "label": "Heading 2",
   "default": "Privacy"
  },
  {
   "type": "textarea",
   "id": "s6",
   "label": "Text 2",
   "default": "We collect the minimum needed to send our products and a story: name, address, email, and order. Payment details are handled by our payment processor and never touch our servers. We do not sell data and we do not share it with advertisers."
  },
  {
   "type": "text",
   "id": "s7",
   "label": "Heading 3",
   "default": "Terms of&nbsp;sale"
  },
  {
   "type": "textarea",
   "id": "s8",
   "label": "Text 3",
   "default": "Prices include VAT applicable to the country you are in, and are shown in the currency of the country your browser is directed to. All items are not returnable."
  },
  {
   "type": "text",
   "id": "s9",
   "label": "Text 4",
   "default": "Nothing in these terms affects your statutory rights."
  },
  {
   "type": "text",
   "id": "s10",
   "label": "Heading 4",
   "default": "Cookies"
  },
  {
   "type": "textarea",
   "id": "s11",
   "label": "Text 5",
   "default": "This demo stores your bag in the browser session and nothing else. We only use strictly necessary cookies for the basket and checkout, and analytics only with consent."
  },
  {
   "type": "text",
   "id": "s12",
   "label": "Link label",
   "default": "Home"
  },
  {
   "type": "text",
   "id": "s13",
   "label": "Link label 2",
   "default": "info@sidestoryparfums.com"
  }
 ],
 "presets": [
  {
   "name": "Legal content"
  }
 ]
}
{% endschema %}
