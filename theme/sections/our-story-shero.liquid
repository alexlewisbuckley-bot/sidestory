<section class="shero tall">
  {% if section.settings.s1 %}<img alt="{{ section.settings.s1.alt | escape }}" src="{{ section.settings.s1 | image_url: width: 1600 }}" loading="lazy">{% else %}<img src="https://sidestory-rho.vercel.app/assets/img/house-hero.jpg?v=5ba021e2" alt="The founders in the atelier" fetchpriority="high" decoding="async">{% endif %}
  <span class="veil" aria-hidden="true"></span>
  <div class="inner">
    <div class="c">
      <p class="k">{{ section.settings.s3 }}</p>
      <h1>{{ section.settings.s4 }}</h1>
      <div class="cta">
        <a class="btn btn-ivory" href="{{ section.settings.s2 }}">{{ section.settings.s5 }}</a>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
 "name": "Shero",
 "settings": [
  {
   "type": "image_picker",
   "id": "s1",
   "label": "Image (blank = current)"
  },
  {
   "type": "text",
   "id": "s2",
   "label": "Link URL",
   "default": "/collections/the-fragrances"
  },
  {
   "type": "text",
   "id": "s3",
   "label": "Text",
   "default": "Our story"
  },
  {
   "type": "textarea",
   "id": "s4",
   "label": "Heading",
   "default": "It&rsquo;s a&nbsp;story left behind in an elevator, or carried gently on a&nbsp;breeze. The kiss of fragrance on a&nbsp;lapel, in the yellowed pages of a&nbsp;diary, or folded into a&nbsp;handkerchief."
  },
  {
   "type": "text",
   "id": "s5",
   "label": "Link label",
   "default": "Shop fragrances"
  }
 ],
 "presets": [
  {
   "name": "Shero"
  }
 ]
}
{% endschema %}
