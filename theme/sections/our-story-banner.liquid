<section class="banner">
  {% if section.settings.s1 %}<img alt="{{ section.settings.s1.alt | escape }}" src="{{ section.settings.s1 | image_url: width: 1600 }}" loading="lazy">{% else %}<picture><source type="image/avif" srcset="https://sidestory-rho.vercel.app/assets/img/founders-480.avif?v=e4758b8c 480w, https://sidestory-rho.vercel.app/assets/img/founders-960.avif?v=072fede8 960w, https://sidestory-rho.vercel.app/assets/img/founders-1600.avif?v=787feb2e 1600w" sizes="100vw"><source type="image/webp" srcset="https://sidestory-rho.vercel.app/assets/img/founders-480.webp?v=1b8aa762 480w, https://sidestory-rho.vercel.app/assets/img/founders-960.webp?v=57b4a5fd 960w, https://sidestory-rho.vercel.app/assets/img/founders-1600.webp?v=9809c80f 1600w" sizes="100vw"><img src="https://sidestory-rho.vercel.app/assets/img/founders.jpg?v=b4fe6c2f" alt="The founders in the studio" decoding="async" width="1600" height="828" srcset="https://sidestory-rho.vercel.app/assets/img/founders-480.jpg?v=90a401f5 480w, https://sidestory-rho.vercel.app/assets/img/founders-960.jpg?v=6ab03efc 960w, https://sidestory-rho.vercel.app/assets/img/founders-1600.jpg?v=c53f60c3 1600w" sizes="100vw"></picture>{% endif %}
  <div class="c">
    <p class="k">{{ section.settings.s2 }}</p>
    <h1>{{ section.settings.s3 }}</h1>
    <p>{{ section.settings.s4 }}</p>
  </div>
</section>
{% schema %}
{
 "name": "Banner",
 "settings": [
  {
   "type": "image_picker",
   "id": "s1",
   "label": "Image (blank = current)"
  },
  {
   "type": "text",
   "id": "s2",
   "label": "Text",
   "default": "Our story"
  },
  {
   "type": "text",
   "id": "s3",
   "label": "Heading",
   "default": "It&rsquo;s a&nbsp;story left behind in an elevator, or carried gently on a&nbsp;breeze."
  },
  {
   "type": "textarea",
   "id": "s4",
   "label": "Text 2",
   "default": "The kiss of fragrance on a lapel, in the yellowed pages of a diary, or folded into a handkerchief."
  }
 ],
 "presets": [
  {
   "name": "Banner"
  }
 ]
}
{% endschema %}
