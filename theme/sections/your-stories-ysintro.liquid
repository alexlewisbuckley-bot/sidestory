<section class="ysintro">
  <div class="inner">
    <p class="k">{{ section.settings.s1 }}</p>
    <h1>{{ section.settings.s2 }}</h1>
    <p class="lede">{{ section.settings.s3 }}</p>
  </div>
</section>
{% schema %}
{
 "name": "Ysintro",
 "settings": [
  {
   "type": "text",
   "id": "s1",
   "label": "Text",
   "default": "Your stories"
  },
  {
   "type": "text",
   "id": "s2",
   "label": "Heading",
   "default": "Seven stories. Read one on&nbsp;us."
  },
  {
   "type": "textarea",
   "id": "s3",
   "label": "Text 2",
   "default": "Every fragrance we make began as fiction, commissioned before a&nbsp;single note was weighed. Read them here in full &mdash; the printed edition arrives in the&nbsp;box."
  }
 ],
 "presets": [
  {
   "name": "Ysintro"
  }
 ]
}
{% endschema %}
