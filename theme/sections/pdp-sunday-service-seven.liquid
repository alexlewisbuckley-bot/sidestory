<section class="seven">
      <div class="inner">
        <div class="head"><div><p class="k">{{ section.settings.s14 }}</p><h2>{{ section.settings.s15 }}</h2></div>
          <a class="ul" href="{{ section.settings.s5 }}">{{ section.settings.s24 }}</a></div>
        <div class="cards">
          <article class="card" data-slug="hotel-lobby" data-order="0" data-feeling="Anticipation" data-stone="Nero Marquina" data-note="Woods" data-family="woods green">
        <div class="ph"><a data-href href="{{ section.settings.s6 }}">{% if section.settings.s1 %}<img alt="{{ section.settings.s1.alt | escape }}" src="{{ section.settings.s1 | image_url: width: 1600 }}" loading="lazy">{% else %}<picture><source type="image/avif" srcset="https://sidestory-rho.vercel.app/assets/img/p-hotel-lobby-card-480.avif?v=d06022d4 480w" sizes="(min-width:68em) 300px, (min-width:40em) 46vw, 92vw"><source type="image/webp" srcset="https://sidestory-rho.vercel.app/assets/img/p-hotel-lobby-card-480.webp?v=a060abfc 480w" sizes="(min-width:68em) 300px, (min-width:40em) 46vw, 92vw"><img data-shot src="https://sidestory-rho.vercel.app/assets/img/p-hotel-lobby-card.jpg?v=8eb4a7ea" alt="Hotel Lobby eau de parfum" loading="lazy" decoding="async" width="873" height="874" srcset="https://sidestory-rho.vercel.app/assets/img/p-hotel-lobby-card-480.jpg?v=1e8f58f2 480w" sizes="(min-width:68em) 300px, (min-width:40em) 46vw, 92vw"></picture>{% endif %}</a><span class="badge">{{ section.settings.s25 }}</span>
          <div class="quick"><div class="r">
            <button class="btn btn-ink btn-sm" data-buy data-size="100ml" onclick="addToBag('hotel-lobby',this.dataset.size,this)">100 ml &mdash; &pound;160</button>
            <button class="btn btn-ghostink btn-sm" data-buy data-size="7-5ml" onclick="addToBag('hotel-lobby',this.dataset.size,this)">7.5 ml &mdash; &pound;25</button>
          </div><small data-incl>The printed story is in the box</small></div></div>
        <div class="meta"><span class="chip" style="background:var(--stone-hotel-lobby)"></span><span class="stone">{{ section.settings.s26 }}</span>
          <h3>{{ section.settings.s16 }}</h3><p class="notes">{{ section.settings.s17 }}</p>
          <p class="price"><span data-priceline>&pound;160 &middot; 100 ml</span><a class="ul" data-href href="{{ section.settings.s7 }}">{{ section.settings.s27 }}</a></p></div>
      </article>
      <article class="card" data-slug="sibling-rivalry" data-order="2" data-feeling="FILLER" data-stone="Leopard Salome" data-note="FILLER — style to come" data-family="">
        <div class="ph"><a data-href href="{{ section.settings.s8 }}">{% if section.settings.s2 %}<img alt="{{ section.settings.s2.alt | escape }}" src="{{ section.settings.s2 | image_url: width: 1600 }}" loading="lazy">{% else %}<picture><source type="image/avif" srcset="https://sidestory-rho.vercel.app/assets/img/p-sibling-rivalry-card-480.avif?v=15d4c266 480w" sizes="(min-width:68em) 300px, (min-width:40em) 46vw, 92vw"><source type="image/webp" srcset="https://sidestory-rho.vercel.app/assets/img/p-sibling-rivalry-card-480.webp?v=61f98f47 480w" sizes="(min-width:68em) 300px, (min-width:40em) 46vw, 92vw"><img data-shot src="https://sidestory-rho.vercel.app/assets/img/p-sibling-rivalry-card.jpg?v=9cfa79c8" alt="Sibling Rivalry eau de parfum" loading="lazy" decoding="async" width="874" height="874" srcset="https://sidestory-rho.vercel.app/assets/img/p-sibling-rivalry-card-480.jpg?v=eeca37ba 480w" sizes="(min-width:68em) 300px, (min-width:40em) 46vw, 92vw"></picture>{% endif %}</a>
          <div class="quick"><div class="r">
            <button class="btn btn-ink btn-sm" data-buy data-size="100ml" onclick="addToBag('sibling-rivalry',this.dataset.size,this)">100 ml &mdash; &pound;160</button>
            <button class="btn btn-ghostink btn-sm" data-buy data-size="7-5ml" onclick="addToBag('sibling-rivalry',this.dataset.size,this)">7.5 ml &mdash; &pound;25</button>
          </div><small data-incl>The printed story is in the box</small></div></div>
        <div class="meta"><span class="chip" style="background:var(--stone-sibling-rivalry)"></span><span class="stone">{{ section.settings.s28 }}</span>
          <h3>{{ section.settings.s18 }}</h3><p class="notes">{{ section.settings.s19 }}</p>
          <p class="price"><span data-priceline>&pound;160 &middot; 100 ml</span><a class="ul" data-href href="{{ section.settings.s9 }}">{{ section.settings.s29 }}</a></p></div>
      </article>
      <article class="card" data-slug="third-date" data-order="3" data-feeling="Fervour" data-stone="Rosso Levanto" data-note="Green" data-family="green floral">
        <div class="ph"><a data-href href="{{ section.settings.s10 }}">{% if section.settings.s3 %}<img alt="{{ section.settings.s3.alt | escape }}" src="{{ section.settings.s3 | image_url: width: 1600 }}" loading="lazy">{% else %}<picture><source type="image/avif" srcset="https://sidestory-rho.vercel.app/assets/img/p-third-date-card-480.avif?v=5d2f8998 480w" sizes="(min-width:68em) 300px, (min-width:40em) 46vw, 92vw"><source type="image/webp" srcset="https://sidestory-rho.vercel.app/assets/img/p-third-date-card-480.webp?v=a264f59d 480w" sizes="(min-width:68em) 300px, (min-width:40em) 46vw, 92vw"><img data-shot src="https://sidestory-rho.vercel.app/assets/img/p-third-date-card.jpg?v=c8f7af1f" alt="Third Date eau de parfum" loading="lazy" decoding="async" width="647" height="648" srcset="https://sidestory-rho.vercel.app/assets/img/p-third-date-card-480.jpg?v=aabe423a 480w" sizes="(min-width:68em) 300px, (min-width:40em) 46vw, 92vw"></picture>{% endif %}</a>
          <div class="quick"><div class="r">
            <button class="btn btn-ink btn-sm" data-buy data-size="100ml" onclick="addToBag('third-date',this.dataset.size,this)">100 ml &mdash; &pound;160</button>
            <button class="btn btn-ghostink btn-sm" data-buy data-size="7-5ml" onclick="addToBag('third-date',this.dataset.size,this)">7.5 ml &mdash; &pound;25</button>
          </div><small data-incl>The printed story is in the box</small></div></div>
        <div class="meta"><span class="chip" style="background:var(--stone-third-date)"></span><span class="stone">{{ section.settings.s30 }}</span>
          <h3>{{ section.settings.s20 }}</h3><p class="notes">{{ section.settings.s21 }}</p>
          <p class="price"><span data-priceline>&pound;160 &middot; 100 ml</span><a class="ul" data-href href="{{ section.settings.s11 }}">{{ section.settings.s31 }}</a></p></div>
      </article>
      <article class="card" data-slug="road-trip" data-order="4" data-feeling="Escaping" data-stone="Rosso Francia" data-note="Amber" data-family="amber woods">
        <div class="ph"><a data-href href="{{ section.settings.s12 }}">{% if section.settings.s4 %}<img alt="{{ section.settings.s4.alt | escape }}" src="{{ section.settings.s4 | image_url: width: 1600 }}" loading="lazy">{% else %}<picture><source type="image/avif" srcset="https://sidestory-rho.vercel.app/assets/img/p-road-trip-card-480.avif?v=0894320f 480w" sizes="(min-width:68em) 300px, (min-width:40em) 46vw, 92vw"><source type="image/webp" srcset="https://sidestory-rho.vercel.app/assets/img/p-road-trip-card-480.webp?v=8e6dc71c 480w" sizes="(min-width:68em) 300px, (min-width:40em) 46vw, 92vw"><img data-shot src="https://sidestory-rho.vercel.app/assets/img/p-road-trip-card.jpg?v=a257a32a" alt="Road Trip eau de parfum" loading="lazy" decoding="async" width="833" height="833" srcset="https://sidestory-rho.vercel.app/assets/img/p-road-trip-card-480.jpg?v=6aaeda5b 480w" sizes="(min-width:68em) 300px, (min-width:40em) 46vw, 92vw"></picture>{% endif %}</a><span class="badge">{{ section.settings.s32 }}</span>
          <div class="quick"><div class="r">
            <button class="btn btn-ink btn-sm" data-buy data-size="100ml" onclick="addToBag('road-trip',this.dataset.size,this)">100 ml &mdash; &pound;160</button>
            <button class="btn btn-ghostink btn-sm" data-buy data-size="7-5ml" onclick="addToBag('road-trip',this.dataset.size,this)">7.5 ml &mdash; &pound;25</button>
          </div><small data-incl>The printed story is in the box</small></div></div>
        <div class="meta"><span class="chip" style="background:var(--stone-road-trip)"></span><span class="stone">{{ section.settings.s33 }}</span>
          <h3>{{ section.settings.s22 }}</h3><p class="notes">{{ section.settings.s23 }}</p>
          <p class="price"><span data-priceline>&pound;160 &middot; 100 ml</span><a class="ul" data-href href="{{ section.settings.s13 }}">{{ section.settings.s34 }}</a></p></div>
      </article>
        </div>
      </div>
    </section>
