<section class="yfeat">
  <video autoplay muted loop playsinline preload="metadata" poster="https://sidestory-rho.vercel.app/assets/img/story-sunday-service.jpg?v=3e735f73"><source src="https://cdn.shopify.com/videos/c/o/v/da03d65c57264c91882acb2f5f947d66.mp4" type="video/mp4"></video>
  <span class="veil" aria-hidden="true"></span>
  <div class="inner">
    <div class="c rev">
      <p class="k">{{ section.settings.s2 }}</p>
      <h2>{{ section.settings.s3 }}</h2>
      <p class="q">{{ section.settings.s4 }}</p>
      <a class="ul" href="{{ section.settings.s1 }}">{{ section.settings.s5 }}</a>
    </div>
  </div>
</section>
{% schema %}
{
 "name": "Featured story",
 "settings": [
  {
   "type": "text",
   "id": "s1",
   "label": "Link URL",
   "default": "/pages/stories"
  },
  {
   "type": "text",
   "id": "s2",
   "label": "Text",
   "default": "Story II &middot; 7 min read"
  },
  {
   "type": "text",
   "id": "s3",
   "label": "Heading",
   "default": "Sunday Service"
  },
  {
   "type": "textarea",
   "id": "s4",
   "label": "Text 2",
   "default": "&ldquo;Now the leaves were dense and green, hanging heavy over the road and mottling the light on his dashboard.&rdquo;"
  },
  {
   "type": "text",
   "id": "s5",
   "label": "Link label",
   "default": "Read the stories &rarr;"
  }
 ],
 "presets": [
  {
   "name": "Featured story"
  }
 ]
}
{% endschema %}
