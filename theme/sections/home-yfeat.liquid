<section class="yfeat">
  {% if section.settings.s1 %}<img alt="{{ section.settings.s1.alt | escape }}" src="{{ section.settings.s1 | image_url: width: 1600 }}" loading="lazy">{% else %}<picture><source type="image/avif" srcset="https://sidestory-rho.vercel.app/assets/img/story-sunday-service-480.avif?v=dbd522ea 480w, https://sidestory-rho.vercel.app/assets/img/story-sunday-service-960.avif?v=3182da98 960w, https://sidestory-rho.vercel.app/assets/img/story-sunday-service-1600.avif?v=b096a9cd 1600w" sizes="100vw"><source type="image/webp" srcset="https://sidestory-rho.vercel.app/assets/img/story-sunday-service-480.webp?v=e87fb359 480w, https://sidestory-rho.vercel.app/assets/img/story-sunday-service-960.webp?v=f1a4da10 960w, https://sidestory-rho.vercel.app/assets/img/story-sunday-service-1600.webp?v=3ed137fe 1600w" sizes="100vw"><img src="https://sidestory-rho.vercel.app/assets/img/story-sunday-service.jpg?v=299feee0" alt="Sunday Service" fetchpriority="high" decoding="async" width="1800" height="960" srcset="https://sidestory-rho.vercel.app/assets/img/story-sunday-service-480.jpg?v=fd267d52 480w, https://sidestory-rho.vercel.app/assets/img/story-sunday-service-960.jpg?v=93ed7b80 960w, https://sidestory-rho.vercel.app/assets/img/story-sunday-service-1600.jpg?v=0f6d4d9e 1600w" sizes="100vw"></picture>{% endif %}
  <video class="film" autoplay muted loop playsinline webkit-playsinline preload="auto" disablepictureinpicture onloadeddata="this.classList.add('ready')"><source src="https://cdn.shopify.com/videos/c/o/v/da03d65c57264c91882acb2f5f947d66.mp4" type="video/mp4"></video>
  <span class="veil" aria-hidden="true"></span>
  <script>/* iOS refuses to autoplay inline video in Low Power Mode, and shows its
  own play glyph over a paused one. The first touch or scroll anywhere on the
  page is a user gesture, and a gesture is all the refusal is waiting for: the
  film is asked again then, and the listeners retire as soon as it is running. */
  (function(){var v=document.querySelector('.yfeat video');if(!v)return;
  v.muted=true;var evs=['touchstart','pointerdown','keydown','scroll'];
  function stop(){evs.forEach(function(e){document.removeEventListener(e,go,true)})}
  function go(){if(!v.paused){stop();return}var p=v.play();
  if(p&&p.then)p.then(stop,function(){})}
  v.addEventListener('playing',stop);go();
  evs.forEach(function(e){document.addEventListener(e,go,{capture:true,passive:true})})})();</script>
  <div class="inner">
    <div class="c rev">
      <p class="k">{{ section.settings.s3 }}</p>
      <h2>{{ section.settings.s4 }}</h2>
      <p class="q">{{ section.settings.s5 }}</p>
      <a class="ul" href="{{ section.settings.s2 }}">{{ section.settings.s6 }}</a>
    </div>
  </div>
</section>
{% schema %}
{
 "name": "Featured story",
 "settings": [
  {
   "type": "image_picker",
   "id": "s1",
   "label": "Image (blank = current)"
  },
  {
   "type": "text",
   "id": "s2",
   "label": "Link URL",
   "default": "/pages/stories"
  },
  {
   "type": "text",
   "id": "s3",
   "label": "Text",
   "default": "Story II &middot; 7 min read"
  },
  {
   "type": "text",
   "id": "s4",
   "label": "Heading",
   "default": "Sunday Service"
  },
  {
   "type": "textarea",
   "id": "s5",
   "label": "Text 2",
   "default": "&ldquo;Now the leaves were dense and green, hanging heavy over the road and mottling the light on his dashboard.&rdquo;"
  },
  {
   "type": "text",
   "id": "s6",
   "label": "Link label",
   "default": "Read the stories &rarr;"
  }
 ],
 "presets": [
  {
   "name": "Featured story"
  }
 ]
}
{% endschema %}
