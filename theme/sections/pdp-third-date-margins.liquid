<section class="margins">
      <div class="inner">
        <p class="k">{{ section.settings.s1 }}</p>
        <h2>{{ section.settings.s2 }}</h2>
        <div class="pyramid">
          <div><b>{{ section.settings.s3 }}</b><em>{{ section.settings.s4 }}</em></div>
      <div><b>{{ section.settings.s5 }}</b><em>{{ section.settings.s6 }}</em></div>
      <div><b>{{ section.settings.s7 }}</b><em>{{ section.settings.s8 }}</em></div>
        </div>
      </div>
    </section>
