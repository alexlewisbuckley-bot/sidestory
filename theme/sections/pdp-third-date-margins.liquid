   "id": "s1",
   "label": "Text",
   "default": "Notes &amp; composition"
  },
  {
   "type": "text",
   "id": "s2",
   "label": "Heading",
   "default": "The pyramid, read as&nbsp;margins."
  },
  {
   "type": "text",
   "id": "s3",
   "label": "Label",
   "default": "Top"
  },
  {
   "type": "text",
   "id": "s4",
   "label": "Label 2",
   "default": "Plum / Ginger"
  },
  {
   "type": "text",
   "id": "s5",
   "label": "Label 3",
   "default": "Middle"
  },
  {
   "type": "text",
   "id": "s6",
   "label": "Label 4",
   "default": "Tuberose / Patchouli"
  },
  {
   "type": "text",
   "id": "s7",
   "label": "Label 5",
   "default": "Base"
  },
  {
   "type": "text",
   "id": "s8",
   "label": "Label 6",
   "default": "Vanilla / Musk"
  }
 ],
 "presets": [
  {
   "name": "Margins"
  }
 ]
}
{% endschema %}
