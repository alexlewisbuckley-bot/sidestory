      <div class="pdp">
        <div class="gal">
          <picture><source type="image/avif" srcset="https://sidestory-rho.vercel.app/assets/img/p-sibling-rivalry-hero-480.avif?v=3df3a9e6 480w" sizes="(min-width:60em) 600px, 92vw"><source type="image/webp" srcset="https://sidestory-rho.vercel.app/assets/img/p-sibling-rivalry-hero-480.webp?v=8e7dde01 480w" sizes="(min-width:60em) 600px, 92vw"><img class="main" id="pdpmain" src="https://sidestory-rho.vercel.app/assets/img/p-sibling-rivalry-hero.jpg?v=8d5962db" alt="Sibling Rivalry eau de parfum" decoding="async" width="874" height="874" srcset="https://sidestory-rho.vercel.app/assets/img/p-sibling-rivalry-hero-480.jpg?v=87d477b6 480w" sizes="(min-width:60em) 600px, 92vw"></picture>
          <div class="strip"><button aria-current="true" onclick="pdpSwap(this,'https://sidestory-rho.vercel.app/assets/img/p-sibling-rivalry-hero.jpg?v=8d5962db')"><picture><source type="image/avif" srcset="https://sidestory-rho.vercel.app/assets/img/p-sibling-rivalry-hero-480.avif?v=3df3a9e6 480w" sizes="100vw"><source type="image/webp" srcset="https://sidestory-rho.vercel.app/assets/img/p-sibling-rivalry-hero-480.webp?v=8e7dde01 480w" sizes="100vw"><img src="https://sidestory-rho.vercel.app/assets/img/p-sibling-rivalry-hero.jpg?v=8d5962db" alt="The bottle" loading="lazy" decoding="async" width="874" height="874" srcset="https://sidestory-rho.vercel.app/assets/img/p-sibling-rivalry-hero-480.jpg?v=87d477b6 480w" sizes="100vw"></picture></button></div>
        </div>
        <div class="info">
