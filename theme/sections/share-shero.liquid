<section class="shero">
  {% if section.settings.s1 %}<img alt="{{ section.settings.s1.alt | escape }}" src="{{ section.settings.s1 | image_url: width: 1600 }}" loading="lazy">{% else %}<picture><source type="image/avif" srcset="https://sidestory-rho.vercel.app/assets/img/share-hero-480.avif?v=e30660e9 480w, https://sidestory-rho.vercel.app/assets/img/share-hero-960.avif?v=0e9fb7b2 960w, https://sidestory-rho.vercel.app/assets/img/share-hero-1600.avif?v=b67fe859 1600w" sizes="100vw"><source type="image/webp" srcset="https://sidestory-rho.vercel.app/assets/img/share-hero-480.webp?v=af68e44c 480w, https://sidestory-rho.vercel.app/assets/img/share-hero-960.webp?v=abb3278f 960w, https://sidestory-rho.vercel.app/assets/img/share-hero-1600.webp?v=6c0c22b1 1600w" sizes="100vw"><img src="https://sidestory-rho.vercel.app/assets/img/share-hero.jpg?v=7fd443c8" alt="Two people either side of a dark table, three bottles standing between them" fetchpriority="high" decoding="async" width="1950" height="909" srcset="https://sidestory-rho.vercel.app/assets/img/share-hero-480.jpg?v=353f1c44 480w, https://sidestory-rho.vercel.app/assets/img/share-hero-960.jpg?v=b50612eb 960w, https://sidestory-rho.vercel.app/assets/img/share-hero-1600.jpg?v=02e9907d 1600w" sizes="100vw"></picture>{% endif %}
  <span class="veil" aria-hidden="true"></span>
  <div class="inner">
    <div class="c">
      <p class="k">{{ section.settings.s2 }}</p>
      <h1>{{ section.settings.s3 }}</h1>
      <p class="lede">{{ section.settings.s4 }}</p>
      <div class="cta">
        <a class="btn btn-ivory" href="#tellus">{{ section.settings.s5 }}</a>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
 "name": "Shero",
 "settings": [
  {
   "type": "image_picker",
   "id": "s1",
   "label": "Image (blank = current)"
  },
  {
   "type": "text",
   "id": "s2",
   "label": "Text",
   "default": "Your stories &middot; an open call"
  },
  {
   "type": "text",
   "id": "s3",
   "label": "Heading",
   "default": "We base our scents on life&rsquo;s stories and&nbsp;narratives."
  },
  {
   "type": "textarea",
   "id": "s4",
   "label": "Text 2",
   "default": "Inspire us with yours, and write to us with as much or as little as you wish. A&nbsp;moment in time, an experience, an excerpt to a&nbsp;longer chapter. Those which we can capture into a&nbsp;scent, we&nbsp;will."
  },
  {
   "type": "text",
   "id": "s5",
   "label": "Link label",
   "default": "Write yours"
  }
 ],
 "presets": [
  {
   "name": "Shero"
  }
 ]
}
{% endschema %}
