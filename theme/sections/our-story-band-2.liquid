<section class="band tint" id="credo">
  <div class="inner">
    <p class="k">{{ section.settings.s1 }}</p>
    <h2>{{ section.settings.s2 }}</h2>
    <p class="lede">{{ section.settings.s3 }}</p>
    <ul class="credo">
      <li class="c-book"><span class="ci" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><path d="M12 6.6C10.5 5.3 8.4 4.7 6 4.7H3v12.8h3c2.4 0 4.5.6 6 1.8 1.5-1.2 3.6-1.8 6-1.8h3V4.7h-3c-2.4 0-4.5.6-6 1.9z"/><path d="M12 6.6v13"/></svg></span><p>{{ section.settings.s4 }}</p></li>
      <li class="c-drop"><span class="ci" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.4c3.2 3.7 5.4 6.7 5.4 9.4a5.4 5.4 0 1 1-10.8 0c0-2.7 2.2-5.7 5.4-9.4z"/><path d="M9.4 13.6a2.6 2.6 0 0 0 2.6 2.6"/></svg></span><p>{{ section.settings.s5 }}</p></li>
      <li class="c-pestle"><span class="ci" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><path d="M4.6 10.4h14.8"/><path d="M6.2 10.4c0 3.9 2.6 6.7 5.8 6.7s5.8-2.8 5.8-6.7"/><path d="M12 17.1v3.4"/><path d="M8.4 20.5h7.2"/><path d="M19.4 3.6 14 9"/></svg></span><p>{{ section.settings.s6 }}</p></li>
      <li class="c-venn"><span class="ci" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><circle cx="9.4" cy="12" r="5.9"/><circle cx="14.6" cy="12" r="5.9"/></svg></span><p>{{ section.settings.s7 }}</p></li>
      <li class="c-hourglass"><span class="ci" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><path d="M6.6 3.5h10.8"/><path d="M6.6 20.5h10.8"/><path d="M8.2 3.5v3.1c0 2 1.5 3.7 3.8 5.4 2.3-1.7 3.8-3.4 3.8-5.4V3.5"/><path d="M8.2 20.5v-3.1c0-2 1.5-3.7 3.8-5.4 2.3 1.7 3.8 3.4 3.8 5.4v3.1"/></svg></span><p>{{ section.settings.s8 }}</p></li>
      <li class="c-sunrise"><span class="ci" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><path d="M3.4 19.4h17.2"/><path d="M8.1 15.6a3.9 3.9 0 0 1 7.8 0"/><path d="M12 4.2v2.4M5.7 7.1l1.7 1.7M18.3 7.1l-1.7 1.7M2.6 13.4H5M21.4 13.4H19"/></svg></span><p>{{ section.settings.s9 }}</p></li>
      <li class="c-leaf"><span class="ci" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><path d="M19.4 4.6C10.8 4.6 6 8.9 6 15.1c0 1.6.4 3.1 1.1 4.3"/><path d="M19.4 4.6c0 8.6-4.6 13.1-11 13.8"/><path d="M4.6 20.5c1-2.7 2.6-5 4.8-6.8"/></svg></span><p>{{ section.settings.s10 }}</p></li>
      <li class="c-compass"><span class="ci" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.6"/><path d="m15.3 8.7-2.1 4.5-4.5 2.1 2.1-4.5z"/></svg></span><p>{{ section.settings.s11 }}</p></li>
    </ul>
  </div>
</section>
{% schema %}
{
 "name": "Story band",
 "settings": [
  {
   "type": "text",
   "id": "s1",
   "label": "Text",
   "default": "Atelier philosophy"
  },
  {
   "type": "text",
   "id": "s2",
   "label": "Heading",
   "default": "Our credo"
  },
  {
   "type": "text",
   "id": "s3",
   "label": "Text 2",
   "default": "Eight positions the house keeps to, and has not found a&nbsp;reason to&nbsp;revise."
  },
  {
   "type": "text",
   "id": "s4",
   "label": "Text 3",
   "default": "fragrances based on stories, rather than stories composed for arbitrary fragrances"
  },
  {
   "type": "textarea",
   "id": "s5",
   "label": "Text 4",
   "default": "perfume should be one of life&rsquo;s unremitting addictions, one that necessitates feeding"
  },
  {
   "type": "text",
   "id": "s6",
   "label": "Text 5",
   "default": "the best craftsmen work alone, with aged tools, and in dimly lit workshops"
  },
  {
   "type": "text",
   "id": "s7",
   "label": "Text 6",
   "default": "endorse cultural coalescence as being the only way forward"
  },
  {
   "type": "text",
   "id": "s8",
   "label": "Text 7",
   "default": "fewer choices, less iterations and lengthier ownership"
  },
  {
   "type": "text",
   "id": "s9",
   "label": "Text 8",
   "default": "perfume should last until the next day, like it did on our grandmothers"
  },
  {
   "type": "text",
   "id": "s10",
   "label": "Text 9",
   "default": "raw materials bought by harvest and by field, never by the year\u2019s average"
  },
  {
   "type": "text",
   "id": "s11",
   "label": "Text 10",
   "default": "to never be guided by compulsions, or pay homage to passing trends."
  }
 ],
 "presets": [
  {
   "name": "Story band"
  }
 ]
}
{% endschema %}
