<section class="band tint" id="making">
  <div class="inner">
    <p class="k">{{ section.settings.s5 }}</p>
    <h2>{{ section.settings.s6 }}</h2>
    <div class="grid-2">
      <figure>{% if section.settings.s3 %}<img class="figfull" alt="{{ section.settings.s3.alt | escape }}" src="{{ section.settings.s3 | image_url: width: 1600 }}" loading="lazy">{% else %}<img class="figfull" src="https://sidestory-rho.vercel.app/assets/img/making-hearth.jpg?v=bda6cf7f" alt="A Road Trip bottle on the hearth" loading="lazy" decoding="async">{% endif %}<figcaption class="hint">{{ section.settings.s7 }}</figcaption></figure>
      <figure>{% if section.settings.s4 %}<img class="figfull" alt="{{ section.settings.s4.alt | escape }}" src="{{ section.settings.s4 | image_url: width: 1600 }}" loading="lazy">{% else %}<img class="figfull" src="https://sidestory-rho.vercel.app/assets/img/making-box.jpg?v=acd786eb" alt="The Pillow Talk box, open" loading="lazy" decoding="async">{% endif %}<figcaption class="hint">{{ section.settings.s8 }}</figcaption></figure>
      <figure>{% if section.settings.s1 %}<img class="figfull" alt="{{ section.settings.s1.alt | escape }}" src="{{ section.settings.s1 | image_url: width: 1600 }}" loading="lazy">{% else %}<picture><source type="image/avif" srcset="https://sidestory-rho.vercel.app/assets/img/founders-480.avif?v=e4758b8c 480w, https://sidestory-rho.vercel.app/assets/img/founders-960.avif?v=072fede8 960w, https://sidestory-rho.vercel.app/assets/img/founders-1600.avif?v=787feb2e 1600w" sizes="100vw"><source type="image/webp" srcset="https://sidestory-rho.vercel.app/assets/img/founders-480.webp?v=1b8aa762 480w, https://sidestory-rho.vercel.app/assets/img/founders-960.webp?v=57b4a5fd 960w, https://sidestory-rho.vercel.app/assets/img/founders-1600.webp?v=9809c80f 1600w" sizes="100vw"><img class="figfull" src="https://sidestory-rho.vercel.app/assets/img/founders.jpg?v=b4fe6c2f" alt="The founders at work" loading="lazy" decoding="async" width="1600" height="828" srcset="https://sidestory-rho.vercel.app/assets/img/founders-480.jpg?v=90a401f5 480w, https://sidestory-rho.vercel.app/assets/img/founders-960.jpg?v=6ab03efc 960w, https://sidestory-rho.vercel.app/assets/img/founders-1600.jpg?v=c53f60c3 1600w" sizes="100vw"></picture>{% endif %}<figcaption class="hint">{{ section.settings.s9 }}</figcaption></figure>
      <figure>{% if section.settings.s2 %}<img class="figfull" alt="{{ section.settings.s2.alt | escape }}" src="{{ section.settings.s2 | image_url: width: 1600 }}" loading="lazy">{% else %}<picture><source type="image/avif" srcset="https://sidestory-rho.vercel.app/assets/img/atelier-bench-480.avif?v=d3555179 480w, https://sidestory-rho.vercel.app/assets/img/atelier-bench-960.avif?v=c06acd25 960w, https://sidestory-rho.vercel.app/assets/img/atelier-bench-1600.avif?v=2cc583cc 1600w" sizes="100vw"><source type="image/webp" srcset="https://sidestory-rho.vercel.app/assets/img/atelier-bench-480.webp?v=607111e4 480w, https://sidestory-rho.vercel.app/assets/img/atelier-bench-960.webp?v=0760bd4c 960w, https://sidestory-rho.vercel.app/assets/img/atelier-bench-1600.webp?v=5e7241ca 1600w" sizes="100vw"><img class="figfull" style="object-position:center 34%" src="https://sidestory-rho.vercel.app/assets/img/atelier-bench.jpg?v=b8ef60af" alt="A Road Trip bottle on a workbench beside a glazed jar and a twin-lens camera" loading="lazy" decoding="async" width="1600" height="1067" srcset="https://sidestory-rho.vercel.app/assets/img/atelier-bench-480.jpg?v=fca70ec7 480w, https://sidestory-rho.vercel.app/assets/img/atelier-bench-960.jpg?v=76d85b04 960w, https://sidestory-rho.vercel.app/assets/img/atelier-bench-1600.jpg?v=740f4076 1600w" sizes="100vw"></picture>{% endif %}<figcaption class="hint">{{ section.settings.s10 }}</figcaption></figure>
    </div>
    <div class="cols cols-2">
      <p>{{ section.settings.s11 }}</p>
      <p>{{ section.settings.s12 }}</p>
      <p>{{ section.settings.s13 }}</p>
      <p>{{ section.settings.s14 }}</p>
    </div>
  </div>
</section>
{% schema %}
{
 "name": "Story band",
 "settings": [
  {
   "type": "image_picker",
   "id": "s1",
   "label": "Image (blank = current)"
  },
  {
   "type": "image_picker",
   "id": "s2",
   "label": "Image (blank = current) 2"
  },
  {
   "type": "image_picker",
   "id": "s3",
   "label": "Image (blank = current) 3"
  },
  {
   "type": "image_picker",
   "id": "s4",
   "label": "Image (blank = current) 4"
  },
  {
   "type": "text",
   "id": "s5",
   "label": "Text",
   "default": "The making"
  },
  {
   "type": "text",
   "id": "s6",
   "label": "Heading",
   "default": "The Atelier"
  },
  {
   "type": "text",
   "id": "s7",
   "label": "Caption",
   "default": "Clean botanicals, carefully composed"
  },
  {
   "type": "text",
   "id": "s8",
   "label": "Caption 2",
   "default": "Crafted with intention"
  },
  {
   "type": "text",
   "id": "s9",
   "label": "Caption 3",
   "default": "Fragrances based on stories"
  },
  {
   "type": "text",
   "id": "s10",
   "label": "Caption 4",
   "default": "Aged tools, dim light"
  },
  {
   "type": "textarea",
   "id": "s11",
   "label": "Text 2",
   "default": "All Side Story fragrances begin with clean, natural ingredients, selected for their purity and character. Our farm-to-fragrance approach preserves every botanical, using synthetics only when they provide the most sustainable solution, without compromising the integrity of each scent."
  },
  {
   "type": "textarea",
   "id": "s12",
   "label": "Text 3",
   "default": "Every bottle and lid is crafted by hand in Italy, designed to be treasured long after the fragrance is finished. Made from recyclable materials and presented in entirely plastic-free packaging, every detail reflects thoughtful design and enduring craftsmanship."
  },
  {
   "type": "textarea",
   "id": "s13",
   "label": "Text 4",
   "default": "We create fragrances based on stories, rather than stories composed for arbitrary fragrances. Perfume should be one of life&rsquo;s unremitting addictions, one that necessitates feeding, and one that lasts until the next day, like it did on our grandmothers."
  },
  {
   "type": "textarea",
   "id": "s14",
   "label": "Text 5",
   "default": "We believe the best craftsmen work alone, with aged tools and in dimly lit workshops. We endorse cultural coalescence as the only way forward, favour fewer choices, less iteration and lengthier ownership, and are never guided by compulsions or passing trends."
  }
 ],
 "presets": [
  {
   "name": "Story band"
  }
 ]
}
{% endschema %}
