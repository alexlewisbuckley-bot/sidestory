<section class="gift" id="set">
  <video autoplay muted loop playsinline preload="metadata" poster="https://sidestory-rho.vercel.app/assets/img/set-first-lines.jpg?v=56fb700f"><source src="https://sidestory-rho.vercel.app/assets/media/discovery-set.mp4?v=6384c8cc" type="video/mp4"></video>
  <div class="fade"></div>
  <div class="c rev">
    <p class="k">{{ section.settings.s2 }}</p>
    <h2>{{ section.settings.s3 }}</h2>
    <p>{{ section.settings.s4 }}</p>
    <div class="cta"><button class="btn btn-ivory" onclick="addToBag('set','full',this)">Add the set &mdash; Dhs. 150</button>
      <a class="btn btn-ghost" href="{{ section.settings.s1 }}">{{ section.settings.s5 }}</a></div>
  </div>
</section>
{% schema %}
{
 "name": "Gifting",
 "settings": [
  {
   "type": "text",
   "id": "s1",
   "label": "Link URL",
   "default": "/products/discovery-set"
  },
  {
   "type": "text",
   "id": "s2",
   "label": "Text",
   "default": "The discovery set"
  },
  {
   "type": "text",
   "id": "s3",
   "label": "Heading",
   "default": "Read first. Decide&nbsp;later."
  },
  {
   "type": "textarea",
   "id": "s4",
   "label": "Text 2",
   "default": "All seven stories in miniature &mdash; 2ml of each. Wear each a day over the week, then choose the one you favour."
  },
  {
   "type": "text",
   "id": "s5",
   "label": "Link label",
   "default": "What&rsquo;s in it"
  }
 ],
 "presets": [
  {
   "name": "Gifting"
  }
 ]
}
{% endschema %}
