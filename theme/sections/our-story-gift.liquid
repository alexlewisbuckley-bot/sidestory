<section class="gift bare" id="promise">
  {% if section.settings.s1 %}<img alt="{{ section.settings.s1.alt | escape }}" src="{{ section.settings.s1 | image_url: width: 1600 }}" loading="lazy">{% else %}<picture><source type="image/avif" srcset="https://sidestory-rho.vercel.app/assets/img/unboxing-480.avif?v=f40a926a 480w, https://sidestory-rho.vercel.app/assets/img/unboxing-960.avif?v=2d937597 960w" sizes="100vw"><source type="image/webp" srcset="https://sidestory-rho.vercel.app/assets/img/unboxing-480.webp?v=814595e2 480w, https://sidestory-rho.vercel.app/assets/img/unboxing-960.webp?v=fe9bf68a 960w" sizes="100vw"><img src="https://sidestory-rho.vercel.app/assets/img/unboxing.jpg?v=01cf3ed0" alt="" loading="lazy" decoding="async" width="1400" height="933" srcset="https://sidestory-rho.vercel.app/assets/img/unboxing-480.jpg?v=e910b36a 480w, https://sidestory-rho.vercel.app/assets/img/unboxing-960.jpg?v=e08fa10b 960w" sizes="100vw"></picture>{% endif %}
  <div class="fade"></div>
  <div class="c rev">
    <p class="k">{{ section.settings.s2 }}</p>
    <h2>{{ section.settings.s3 }}</h2>
    <p>{{ section.settings.s4 }}</p>
  </div>
</section>
{% schema %}
{
 "name": "Gifting",
 "settings": [
  {
   "type": "image_picker",
   "id": "s1",
   "label": "Image (blank = current)"
  },
  {
   "type": "text",
   "id": "s2",
   "label": "Text",
   "default": "Our promise"
  },
  {
   "type": "text",
   "id": "s3",
   "label": "Heading",
   "default": "We take responsibility"
  },
  {
   "type": "textarea",
   "id": "s4",
   "label": "Text 2",
   "default": "Ensuring that the high standards we set for ourselves are maintained, from the craftsmanship behind the bottle and packaging, the balance and sillage of the scents, and to the quality and sustainability of the ingredients. None of these elements are ever compromised."
  }
 ],
 "presets": [
  {
   "name": "Gifting"
  }
 ]
}
{% endschema %}
