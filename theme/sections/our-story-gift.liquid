<section class="gift bare" id="promise">
  {% if section.settings.s1 %}<img alt="{{ section.settings.s1.alt | escape }}" src="{{ section.settings.s1 | image_url: width: 1600 }}" loading="lazy">{% else %}<img src="https://sidestory-rho.vercel.app/assets/img/promise-spray.jpg?v=2de46b26" alt="" loading="lazy" decoding="async">{% endif %}
  <div class="fade"></div>
  <div class="c rev">
    <p class="k">{{ section.settings.s2 }}</p>
    <h2>{{ section.settings.s3 }}</h2>
    <p>{{ section.settings.s4 }}</p>
  </div>
</section>
{% schema %}
{
 "name": "Gifting",
 "settings": [
  {
   "type": "image_picker",
   "id": "s1",
   "label": "Image (blank = current)"
  },
  {
   "type": "text",
   "id": "s2",
   "label": "Text",
   "default": "Our promise"
  },
  {
   "type": "text",
   "id": "s3",
   "label": "Heading",
   "default": "We take responsibility"
  },
  {
   "type": "textarea",
   "id": "s4",
   "label": "Text 2",
   "default": "Ensuring that the high standards we set for ourselves are maintained, from the craftsmanship behind the bottle and packaging, the balance and sillage of the scents, and to the quality and sustainability of the ingredients. None of these elements are ever compromised."
  }
 ],
 "presets": [
  {
   "name": "Gifting"
  }
 ]
}
{% endschema %}
