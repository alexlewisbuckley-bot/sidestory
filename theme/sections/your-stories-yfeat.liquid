<section class="yfeat">
  {% if section.settings.s1 %}<img alt="{{ section.settings.s1.alt | escape }}" src="{{ section.settings.s1 | image_url: width: 1600 }}" loading="lazy">{% else %}<picture><source type="image/avif" srcset="https://sidestory-rho.vercel.app/assets/img/story-sunday-service-480.avif?v=5254b42d 480w, https://sidestory-rho.vercel.app/assets/img/story-sunday-service-960.avif?v=cd9c6c22 960w, https://sidestory-rho.vercel.app/assets/img/story-sunday-service-1600.avif?v=274dff5e 1600w" sizes="100vw"><source type="image/webp" srcset="https://sidestory-rho.vercel.app/assets/img/story-sunday-service-480.webp?v=d29b0f8c 480w, https://sidestory-rho.vercel.app/assets/img/story-sunday-service-960.webp?v=b6c4497b 960w, https://sidestory-rho.vercel.app/assets/img/story-sunday-service-1600.webp?v=3a99849b 1600w" sizes="100vw"><img src="https://sidestory-rho.vercel.app/assets/img/story-sunday-service.jpg?v=3e735f73" alt="Sunday Service" decoding="async" width="1800" height="960" srcset="https://sidestory-rho.vercel.app/assets/img/story-sunday-service-480.jpg?v=9d6cc42a 480w, https://sidestory-rho.vercel.app/assets/img/story-sunday-service-960.jpg?v=2c3823eb 960w, https://sidestory-rho.vercel.app/assets/img/story-sunday-service-1600.jpg?v=535e840d 1600w" sizes="100vw"></picture>{% endif %}
  <span class="veil" aria-hidden="true"></span>
  <div class="inner">
    <div class="c rev">
      <p class="k">{{ section.settings.s3 }}</p>
      <h2>{{ section.settings.s4 }}</h2>
      <p class="q">{{ section.settings.s5 }}</p>
      <a class="ul" href="{{ section.settings.s2 }}">{{ section.settings.s6 }}</a>
    </div>
  </div>
</section>
{% schema %}
{
 "name": "Featured story",
 "settings": [
  {
   "type": "image_picker",
   "id": "s1",
   "label": "Image (blank = current)"
  },
  {
   "type": "text",
   "id": "s2",
   "label": "Link URL",
   "default": "/pages/story-sunday-service"
  },
  {
   "type": "text",
   "id": "s3",
   "label": "Text",
   "default": "Story II &middot; 7 min read"
  },
  {
   "type": "text",
   "id": "s4",
   "label": "Heading",
   "default": "Sunday Service"
  },
  {
   "type": "textarea",
   "id": "s5",
   "label": "Text 2",
   "default": "&ldquo;Now the leaves were dense and green, hanging heavy over the road and mottling the light on his dashboard.&rdquo;"
  },
  {
   "type": "text",
   "id": "s6",
   "label": "Link label",
   "default": "Read the story &rarr;"
  }
 ],
 "presets": [
  {
   "name": "Featured story"
  }
 ]
}
{% endschema %}
