<div class="inner">
      <p class="crumb"><a href="{{ section.settings.s1 }}">{{ section.settings.s17 }}</a> / <a href="{{ section.settings.s2 }}">{{ section.settings.s18 }}</a> / The Discovery Set</p>
      <div class="pdp">
        <div class="gal">
          <video class="main" id="setfilm" autoplay muted loop playsinline preload="metadata" poster="https://sidestory-rho.vercel.app/assets/img/set-vials.jpg?v=1c7fb7c1"><source src="https://sidestory-rho.vercel.app/assets/media/discovery-set.mp4?v=6384c8cc" type="video/mp4"></video>
          <img class="main" id="pdpmain" src="https://sidestory-rho.vercel.app/assets/img/set-vials.jpg?v=1c7fb7c1" alt="The Discovery Set" hidden decoding="async">
          <div class="strip"><button aria-current="true" onclick="setShow(null,this)" aria-label="The film"><img src="https://sidestory-rho.vercel.app/assets/img/set-vials.jpg?v=1c7fb7c1" alt="" loading="lazy" decoding="async"></button>
<button onclick="setShow('https://sidestory-rho.vercel.app/assets/img/set-vials.jpg?v=1c7fb7c1',this)" aria-label="The seven vials in their box"><img src="https://sidestory-rho.vercel.app/assets/img/set-vials.jpg?v=1c7fb7c1" alt="" loading="lazy" decoding="async"></button>
<button onclick="setShow('https://sidestory-rho.vercel.app/assets/img/set-skyline.jpg?v=cccd47de',this)" aria-label="The set, opened at dusk"><img src="https://sidestory-rho.vercel.app/assets/img/set-skyline.jpg?v=cccd47de" alt="" loading="lazy" decoding="async"></button>
<button onclick="setShow('https://sidestory-rho.vercel.app/assets/img/set-boxes.jpg?v=e22d6f15',this)" aria-label="The set among the seven boxes"><img src="https://sidestory-rho.vercel.app/assets/img/set-boxes.jpg?v=e22d6f15" alt="" loading="lazy" decoding="async"></button>
<button onclick="setShow('https://sidestory-rho.vercel.app/assets/img/set-boxlid.jpg?v=27a537a5',this)" aria-label="The lid, letterpressed"><img src="https://sidestory-rho.vercel.app/assets/img/set-boxlid.jpg?v=27a537a5" alt="" loading="lazy" decoding="async"></button></div>
          <script>function setShow(src,btn){var v=document.getElementById('setfilm'),m=document.getElementById('pdpmain');
document.querySelectorAll('.gal .strip button').forEach(function(b){b.removeAttribute('aria-current')});
btn.setAttribute('aria-current','true');
if(src){m.src=src;m.hidden=false;v.hidden=true;v.pause();}else{m.hidden=true;v.hidden=false;v.play();}}</script>
        </div>
        <div class="info">
          <p class="k">{{ section.settings.s3 }}</p>
      <h1>{{ section.settings.s4 }}</h1>
      <p class="sub">{{ section.settings.s5 }}</p>
      <blockquote>{{ section.settings.s6 }}</blockquote>

      <p class="fieldlabel">{{ section.settings.s7 }}</p>
      <div class="sizes">
        <button aria-current="true" data-size="full" data-price="30"><span class="szl">Seven &times; 2 ml</span><span class="szp">Dhs. 150</span><span class="szi">Wear each a day over the week, then choose the one you favour</span></button>
      </div>

      <div class="cta">
        <button class="btn btn-ink" data-size="full" onclick="addToBag('set','full',this)">Add to bag &mdash; Dhs. 150</button>
        <button class="btn btn-ghostink applepay" onclick="addToBag('set','full',this)"><svg class="i-apple" viewBox="0 0 384 512" aria-hidden="true" focusable="false"><path d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.931.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z"/></svg> Apple Pay</button>
      </div>

      <div class="acc">
            <details open><summary>{{ section.settings.s8 }}</summary><div class="body"><div class="notelist">
            <p><b>I</b><span>{{ section.settings.s19 }}</span></p>
            <p><b>{{ section.settings.s9 }}</b><span>{{ section.settings.s20 }}</span></p>
            <p><b>{{ section.settings.s10 }}</b><span>{{ section.settings.s21 }}</span></p>
            <p><b>{{ section.settings.s11 }}</b><span>{{ section.settings.s22 }}</span></p>
            <p><b>V</b><span>{{ section.settings.s23 }}</span></p>
            <p><b>{{ section.settings.s12 }}</b><span>{{ section.settings.s24 }}</span></p>
            <p><b>{{ section.settings.s13 }}</b><span>{{ section.settings.s25 }}</span></p>
            </div></div></details>
            <details><summary>{{ section.settings.s14 }}</summary><div class="body">The set arrives as seven 2ml vials in a custom linen box, each paired with a short story elaborating on the scent&rsquo;s inspiration. Wear one a day for a week, then choose the one you favour most. A single sample is Dhs. 25.</div></details>
            <details><summary>{{ section.settings.s15 }}</summary><div class="body">Complimentary UK delivery over Dhs. 150, otherwise Dhs. 25. Two to four working days, signed for. Non-refundable.</div></details>
      </div>

      <div class="pdpbar" id="pdpbar" hidden>
        <div class="r">
          <div class="t"><b>{{ section.settings.s16 }}</b><span data-barprice>Dhs. 150 &middot; seven &times; 2 ml</span></div>
          <button class="btn btn-ink" data-size="full" onclick="addToBag('set','full',this)">Add to bag</button>
        </div>
      </div>
        </div>
      </div>
    </div>
