<section class="atelier">
  <div class="inner">
    <div class="rev"><p class="k">{{ section.settings.s4 }}</p><h2 class="d sechead">{{ section.settings.s5 }}</h2></div>
    <p class="lead rev">{{ section.settings.s6 }}</p>
    <div class="row rail" tabindex="0" role="group" aria-label="The object, in three plates — scroll sideways">
      <figure class="rev">{% if section.settings.s1 %}<img alt="{{ section.settings.s1.alt | escape }}" src="{{ section.settings.s1 | image_url: width: 1600 }}" loading="lazy">{% else %}<picture><source type="image/avif" srcset="https://sidestory-rho.vercel.app/assets/img/stone-shelf-480.avif?v=f02e336a 480w, https://sidestory-rho.vercel.app/assets/img/stone-shelf-960.avif?v=e6e96135 960w, https://sidestory-rho.vercel.app/assets/img/stone-shelf-1600.avif?v=ebfb9f0b 1600w" sizes="100vw"><source type="image/webp" srcset="https://sidestory-rho.vercel.app/assets/img/stone-shelf-480.webp?v=9b545910 480w, https://sidestory-rho.vercel.app/assets/img/stone-shelf-960.webp?v=17f62665 960w, https://sidestory-rho.vercel.app/assets/img/stone-shelf-1600.webp?v=5a1373c3 1600w" sizes="100vw"><img src="https://sidestory-rho.vercel.app/assets/img/stone-shelf.jpg?v=5168998a" alt="" loading="lazy" decoding="async" width="1800" height="1200" srcset="https://sidestory-rho.vercel.app/assets/img/stone-shelf-480.jpg?v=22c8f221 480w, https://sidestory-rho.vercel.app/assets/img/stone-shelf-960.jpg?v=8c40db6e 960w, https://sidestory-rho.vercel.app/assets/img/stone-shelf-1600.jpg?v=2f49b4ad 1600w" sizes="100vw"></picture>{% endif %}
        <figcaption><b>{{ section.settings.s7 }}</b><i>{{ section.settings.s8 }}</i></figcaption></figure>
      <figure class="rev">{% if section.settings.s2 %}<img alt="{{ section.settings.s2.alt | escape }}" src="{{ section.settings.s2 | image_url: width: 1600 }}" loading="lazy">{% else %}<img src="https://sidestory-rho.vercel.app/assets/img/label-linen.jpg?v=101f9e60" alt="The embossed label on linen" loading="lazy" decoding="async">{% endif %}
        <figcaption><b>{{ section.settings.s9 }}</b><i>{{ section.settings.s10 }}</i></figcaption></figure>
      <figure class="rev">{% if section.settings.s3 %}<img alt="{{ section.settings.s3.alt | escape }}" src="{{ section.settings.s3 | image_url: width: 1600 }}" loading="lazy">{% else %}<img src="https://sidestory-rho.vercel.app/assets/img/oil-spray.jpg?v=9df8eb7d" alt="The oil, sprayed" loading="lazy" decoding="async">{% endif %}
        <figcaption><b>{{ section.settings.s11 }}</b><i>{{ section.settings.s12 }}</i></figcaption></figure>
    </div>
  </div>
</section>
{% schema %}
{
 "name": "In the hand",
 "settings": [
  {
   "type": "image_picker",
   "id": "s1",
   "label": "Image (blank = current)"
  },
  {
   "type": "image_picker",
   "id": "s2",
   "label": "Image (blank = current) 2"
  },
  {
   "type": "image_picker",
   "id": "s3",
   "label": "Image (blank = current) 3"
  },
  {
   "type": "text",
   "id": "s4",
   "label": "Text",
   "default": "Heavy in the hand"
  },
  {
   "type": "text",
   "id": "s5",
   "label": "Heading",
   "default": "Purposeful weight. Artisanal creation."
  },
  {
   "type": "textarea",
   "id": "s6",
   "label": "Text 2",
   "default": "The object speaks first \u2014 the cold of the stone, the letterpress bite of the label, the intensity of the oil."
  },
  {
   "type": "text",
   "id": "s7",
   "label": "Label",
   "default": "The stone"
  },
  {
   "type": "text",
   "id": "s8",
   "label": "Small print",
   "default": "hand-turned, never repeated"
  },
  {
   "type": "text",
   "id": "s9",
   "label": "Label 2",
   "default": "The label"
  },
  {
   "type": "text",
   "id": "s10",
   "label": "Small print 2",
   "default": "embossed on linen"
  },
  {
   "type": "text",
   "id": "s11",
   "label": "Label 3",
   "default": "The oil"
  },
  {
   "type": "text",
   "id": "s12",
   "label": "Small print 3",
   "default": "lasting, layered, rich"
  }
 ],
 "presets": [
  {
   "name": "In the hand"
  }
 ]
}
{% endschema %}
