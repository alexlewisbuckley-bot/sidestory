
<section class="seven">
  <div class="inner">
    <p class="crumb"><a href="/">Home</a> / The Fragrances</p>
    <!-- The kicker/headline/lede block stood between the reader and the
         shelf on every collection page — three paragraphs to scroll past to
         reach the first bottle. The h1 stays for the crawler and the screen
         reader; the browsing eye goes straight from the crumb to the shelf. -->
    <h1 class="vh">Seven stories, worn as&nbsp;scent.</h1>
    <div class="shelfbar" data-shelf-for=".cards">
      <button class="filterbtn" type="button" data-open-filters aria-haspopup="dialog"
              aria-expanded="false"><span>Size &amp; scent</span><span class="tally" data-tally hidden>0</span></button>
      <div class="finline">
        <div class="fgroup fgroup-one">
          <span class="lbl" id="lbl-size">Size</span>
          <div class="opts" role="radiogroup" aria-labelledby="lbl-size">
            <button type="button" role="radio" aria-checked="true" tabindex="0" data-filter="size" data-value="100ml"><span class="long">100 ml</span><span class="short">100ml</span></button>
            <button type="button" role="radio" aria-checked="false" tabindex="-1" data-filter="size" data-value="7-5ml"><span class="long">7.5 ml</span><span class="short">7.5ml</span></button>
            <button type="button" role="radio" aria-checked="false" tabindex="-1" data-filter="size" data-value="sample"><span class="long">Sample</span><span class="short">2ml</span></button>
          </div>
        </div>
        <div class="fgroup fgroup-many">
          <span class="lbl" id="lbl-family">Scent</span>
          <div class="opts" role="group" aria-labelledby="lbl-family">
            <button type="button" aria-pressed="false" data-filter="family" data-value="woods">Woods</button>
            <button type="button" aria-pressed="false" data-filter="family" data-value="green">Green</button>
            <button type="button" aria-pressed="false" data-filter="family" data-value="floral">Floral</button>
            <button type="button" aria-pressed="false" data-filter="family" data-value="spice">Spice</button>
            <button type="button" aria-pressed="false" data-filter="family" data-value="amber">Amber</button>
            <button type="button" aria-pressed="false" data-filter="family" data-value="citrus">Citrus</button>
            <button type="button" aria-pressed="false" data-filter="family" data-value="powder">Powder</button>
          </div>
        </div>
      </div>
      <p class="shelfcount"><span data-count>Seven stories</span></p>
    </div>
    <div class="applied" data-applied hidden>
      <span class="alab">Showing</span>
      <span class="achips" data-applied-chips></span>
      <button type="button" class="clear" data-clear>Clear all</button>
    </div>
    <div class="sheetscrim" data-scent-scrim hidden></div>
    <div class="sheet" data-scent-sheet role="dialog" aria-modal="true"
         aria-labelledby="sheet-title" hidden>
      <div class="sheethead">
        <h2 id="sheet-title">Size &amp;&nbsp;scent</h2>
        <button type="button" class="x" data-close-scent aria-label="Close">Close</button>
      </div>
      <div class="sheetlist">
      <section class="sgroup">
        <h3 class="sgh" id="sh-size">Size</h3>
        <p class="sgn">All seven come in every size. This changes the price and the pack, not the shelf.</p>
        <div class="sgrows" role="radiogroup" aria-labelledby="sh-size">
          <button type="button" class="srow srow-one" role="radio" aria-checked="true" tabindex="0" data-filter="size" data-value="100ml"><span class="slab">100 ml<span class="shint">&pound;160 &middot; The printed story is in the box</span></span><i aria-hidden="true"></i></button>
          <button type="button" class="srow srow-one" role="radio" aria-checked="false" tabindex="-1" data-filter="size" data-value="7-5ml"><span class="slab">7.5 ml<span class="shint">&pound;25 &middot; Printed sleeve, no story</span></span><i aria-hidden="true"></i></button>
          <button type="button" class="srow srow-one" role="radio" aria-checked="false" tabindex="-1" data-filter="size" data-value="sample"><span class="slab">Sample<span class="shint">&pound;5 &middot; 2ml, and its opening page</span></span><i aria-hidden="true"></i></button>
        </div>
      </section>
      <section class="sgroup">
        <h3 class="sgh" id="sh-family">Scent</h3>
        <p class="sgn">Choose as many as you like. A story appears under every family its style names.</p>
        <div class="sgrows" role="group" aria-labelledby="sh-family">
          <button type="button" class="srow" aria-pressed="false" data-filter="family" data-value="woods"><span class="slab">Woods<span class="shint">4 stories</span></span><i aria-hidden="true"></i></button>
          <button type="button" class="srow" aria-pressed="false" data-filter="family" data-value="green"><span class="slab">Green<span class="shint">3 stories</span></span><i aria-hidden="true"></i></button>
          <button type="button" class="srow" aria-pressed="false" data-filter="family" data-value="floral"><span class="slab">Floral<span class="shint">2 stories</span></span><i aria-hidden="true"></i></button>
          <button type="button" class="srow" aria-pressed="false" data-filter="family" data-value="spice"><span class="slab">Spice<span class="shint">2 stories</span></span><i aria-hidden="true"></i></button>
          <button type="button" class="srow" aria-pressed="false" data-filter="family" data-value="amber"><span class="slab">Amber<span class="shint">2 stories</span></span><i aria-hidden="true"></i></button>
          <button type="button" class="srow" aria-pressed="false" data-filter="family" data-value="citrus"><span class="slab">Citrus<span class="shint">1 story</span></span><i aria-hidden="true"></i></button>
          <button type="button" class="srow" aria-pressed="false" data-filter="family" data-value="powder"><span class="slab">Powder<span class="shint">1 story</span></span><i aria-hidden="true"></i></button>
        </div>
      </section>
      </div>
      <div class="sheetfoot">
        <button type="button" class="clear" data-clear>Clear all</button>
        <button type="button" class="btn btn-ink" data-close-scent>
          <span>Show <span data-sheetcount>7 stories</span></span></button>
      </div>
    </div>
