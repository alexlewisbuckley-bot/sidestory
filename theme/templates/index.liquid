    <div class="grid-3">
      <figure><picture><source type="image/avif" srcset="https://sidestory-rho.vercel.app/assets/img/plants-480.avif?v=1fde4be5 480w, assets/img/plants-960.avif?v=3765d682 960w" sizes="100vw"><source type="image/webp" srcset="https://sidestory-rho.vercel.app/assets/img/plants-480.webp?v=49eadac5 480w, assets/img/plants-960.webp?v=5ad5650e 960w" sizes="100vw"><img class="figfull" src="https://sidestory-rho.vercel.app/assets/img/plants.jpg?v=058397f4" alt="Botanicals for the compositions" loading="lazy" decoding="async" width="1200" height="800" srcset="https://sidestory-rho.vercel.app/assets/img/plants-480.jpg?v=3895ade1 480w, assets/img/plants-960.jpg?v=c541aad4 960w" sizes="100vw"></picture><figcaption class="hint">clean botanicals, carefully composed</figcaption></figure>
